# ==============================================================================
# StockMate - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase API Credentials
# ------------------------------------------------------------------------------
# Where to find these in your Supabase Dashboard:
# -> Go to: Project Settings (gear icon) -> API
# -> Copy "Project URL" into SUPABASE_URL
# -> Copy "anon" public key into SUPABASE_KEY (and SUPABASE_ANON_KEY)
# -> Copy "service_role" secret key into SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://jtcssotelzoavgxtgamc.supabase.co/rest/v1/
SUPABASE_KEY=sb_secret_5iqEbhlibZW9-_nlZJYicw_BA-1PUxk
SUPABASE_ANON_KEY=sb_publishable_AnyhzmSzYrg85wj7zjuPwQ_K1Nd_80L
SUPABASE_SERVICE_ROLE_KEY=sb_secret_gt3qf8xVTMbufSMLzy5FXA_iLkIZKgq
# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Direct Connection (Optional)
# ------------------------------------------------------------------------------
# Where to find this in Supabase Dashboard:
# -> Go to: Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (Port 6543):
DATABASE_URL=postgresql://postgres:[Adityaghanate]@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Database Backend Mode
# ------------------------------------------------------------------------------
# Options:
#   'supabase' : Use Supabase cloud database
#   'sqlite'   : Use local smart_stock.db (offline fallback)
DB_BACKEND=supabase

# ------------------------------------------------------------------------------
# 4. Flask Application Settings
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-stock-money-manager-secret-key-2026-production
PORT=5000
